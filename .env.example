# 외부 API 키 자리. 복사해서 채운다:  cp .env.example .env   (윈도우: copy .env.example .env)
# .env 는 커밋되지 않는다(.gitignore). 키를 채팅·이슈·PR·코드·로그에 붙이지 않는다.
# 자동화(GitHub Actions)에서 쓸 때는 같은 이름으로 GitHub Secrets에 넣는다.

# ---------------------------------------------------------------- 필수
# 한국관광공사_국문 관광정보 서비스_GW (공공데이터포털 데이터 15101578) — 후보지 데이터
# 마이페이지 > 개발계정 > 일반 인증키 중 "Decoding" 값을 넣는다(요청할 때 라이브러리가 URL 인코딩을 한다).
# 키 위치: 공공데이터포털 마이페이지 > 데이터활용 > Open API > 인증키 발급현황
# 개발계정은 자동승인(신청 후 10~30분), 오퍼레이션별 하루 1,000건. 운영계정만 관광공사 심의(1~3일)
# 요청 필수: serviceKey · MobileOS=AND · MobileApp=<앱 이름>, JSON은 _type=json (기본 XML)
TOURAPI_SERVICE_KEY=
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# ---------------------------------------------------------------- 선택
# 오피넷 유가정보 API — 서버가 하루 1회 전국 평균 단가를 캐시(python -m chagok.prices refresh). 열린 결정 17
OPINET_API_KEY=

# 카카오모빌리티 길찾기(REST API 키) — 실서비스 카드 상위 후보의 실경로·통행료(chagok/routes.py).
# 없으면 직선거리 추정만 쓴다. 데모 고정 모드(demo_seed)는 쓰지 않는다.
KAKAO_REST_API_KEY=

# Anthropic API 키 — A2 사전 큐레이션(python -m chagok.curate, 크론)에서만 쓴다. 요청(/v1/cards)·앱은 쓰지 않는다.
# 콘솔(console.anthropic.com) > API Keys. 이 키로 쓴 비용은 키 주인 계정에 청구된다(curate --max-usd로 상한).
ANTHROPIC_API_KEY=

# 기상청 단기예보(python -m chagok.weather refresh). 비워 두면 TOURAPI_SERVICE_KEY를 쓴다
# (같은 공공데이터포털 계정에서 「기상청_단기예보 조회서비스」 활용신청이 되어 있어야 한다).
# KMA_SERVICE_KEY=

# 순위 규칙: a1 = 규칙(목적지성·날씨), b = a1 + A2 사전 큐레이션. 블라인드 검수 결과로 정한다(기본 a1)
# CHAGOK_RANKER=a1

# ---------------------------------------------------------------- 서버 실행 (보통 비워 둔다)
# 후보·단가 캐시 SQLite 위치. 기본 server/data/chagok.sqlite3, 배포 컨테이너는 /data/chagok.sqlite3(deploy/compose.yaml)
# CHAGOK_DB=
