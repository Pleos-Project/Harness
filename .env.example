# 외부 API 키 자리. 복사해서 채운다:  cp .env.example .env   (윈도우: copy .env.example .env)
# .env 는 커밋되지 않는다(.gitignore). 키를 채팅·이슈·PR·코드·로그에 붙이지 않는다.
# 자동화(GitHub Actions)에서 쓸 때는 같은 이름으로 GitHub Secrets에 넣는다.

# ---------------------------------------------------------------- 필수
# 한국관광공사_국문 관광정보 서비스_GW (공공데이터포털 데이터 15101578) — 후보지 데이터
# 마이페이지 > 개발계정 > 일반 인증키 중 "Decoding" 값을 넣는다(요청할 때 라이브러리가 URL 인코딩을 한다).
# 키 위치: 공공데이터포털 마이페이지 > 데이터활용 > Open API > 인증키 발급현황
# 개발계정은 자동승인(신청 후 10~30분), 오퍼레이션별 하루 1,000건. 운영계정만 관광공사 심의(1~3일)
# 요청 필수: serviceKey · MobileOS=AND · MobileApp=<앱 이름>, JSON은 _type=json (기본 XML)
TOURAPI_SERVICE_KEY=
TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# ---------------------------------------------------------------- 선택
# 오피넷 유가정보 API — 휘발유 기본 단가 갱신(DECISIONS 열린 결정 17). 없으면 fixtures/constants.json 값
OPINET_API_KEY=

# ---------------------------------------------------------------- 보류 (방향 결정 후)
# 카카오모빌리티 길찾기 — 거리·시간을 NaviHelper requestTrip으로 하면 쓰지 않는다
# KAKAO_REST_API_KEY=
